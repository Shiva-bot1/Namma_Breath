# Copy this file to .env (or just export these in your terminal) before running app.py
#
# WAQI_TOKEN — free token from https://aqicn.org/data-platform/token/
# Without this, the backend automatically uses realistic mock data instead.
WAQI_TOKEN=

# ANTHROPIC_API_KEY — optional. Only needed if you want the advisory text
# rephrased by Claude instead of the built-in rule-based templates.
ANTHROPIC_API_KEY=
